<Page x:Class="EscritorioNitroRestaurant.Views.Pages.ReceivesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EscritorioNitroRestaurant.Views.Pages"
      xmlns:uc="clr-namespace:EscritorioNitroRestaurant.Components"
      xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:viewmodels="clr-namespace:EscritorioNitroRestaurant.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="800"
      d:DesignWidth="1000"
      Title="ReceivesPage">

    <Grid Background="#fff">

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="50,0,0,0">
                    <Label Content="Tipo de pago: " FontSize="23" VerticalAlignment="Center"/>
                    <ComboBox Height="30" Width="280"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="50,0,0,0">
                    <Label Content="Fecha inicio: " FontSize="23" VerticalAlignment="Center"/>
                    <ComboBox Height="30" Width="280"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Fecha fin: " FontSize="23" VerticalAlignment="Center"/>
                    <ComboBox Height="30" Width="280"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{StaticResource BrushColor}" BorderThickness="2" Margin="35,20" CornerRadius="25">
                <ScrollViewer Margin="0,10,10,0">
                    <StackPanel>
                        <Label Content="Viernes 13 de mayo" 
                               HorizontalAlignment="Center" 
                               VerticalContentAlignment="Center"
                                   
                               Foreground="{StaticResource PrimaryColor}" 
                               FontSize="23"
                               FontWeight="Bold"
                               Height="70"/>
                        <Border BorderBrush="{StaticResource BrushColor}" BorderThickness="0.5" Margin="30,5,30,0"/>
                        <Button Background="Transparent" BorderThickness="0" Height="80">
                            <Grid Width="1000">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width=".1*"/>
                                    <ColumnDefinition Width=".15*"/>
                                    <ColumnDefinition Width=".15*"/>
                                    <ColumnDefinition Width=".01*"/>
                                    <ColumnDefinition Width=".55*"/>
                                </Grid.ColumnDefinitions>

                                <fa:FontAwesome Grid.Column="0" 
                                                Icon="Money" 
                                                FontSize="50" 
                                                VerticalAlignment="Center" 
                                                Foreground="{StaticResource PrimaryColor}" 
                                                Rotation="350"
                                                HorizontalAlignment="Right"/>

                                <Label Grid.Column="1" Content="$25.00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="23"/>
                                <Label Grid.Column="2" Content="con efectivo" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="23"/>
                                <Border Grid.Column="3" BorderBrush="{StaticResource BrushColor}" BorderThickness="0.5" Height="80" Width="1"/>

                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="3WOJz3ImSxdw7Q9mUAQw" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="23" FontWeight="Light"/>
                                    <TextBlock Grid.Row="1" Text="10:20 p.m." HorizontalAlignment="Center" FontSize="23" FontWeight="Light" Foreground="#666666"/>
                                </Grid>
                            </Grid>
                        </Button>
                        <Border BorderBrush="{StaticResource BrushColor}" BorderThickness="0.5" Margin="30,0,30,0"/>

                        <uc:TableReceiptsBtn Total="{Binding Total}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
